{
  "uid": "mail-logs",
  "title": "Mail logs",
  "tags": ["mail", "logs"],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "filter",
        "type": "textbox",
        "label": "grep",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "logs", "title": "mail.log",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{job=\"mail\"} |= \"$filter\"", "refId": "A" }]
    },
    {
      "id": 2, "type": "logs", "title": "rejects / auth fail / bounce",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{job=\"mail\"} |~ \"(?i)reject|auth_failed|status=bounced|status=deferred|verification failed\"", "refId": "A" }]
    },
    {
      "id": 3, "type": "logs", "title": "journal: postfix / dovecot / opendkim",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{job=\"systemd\", unit=~\"postfix.service|dovecot.service|opendkim.service\"}", "refId": "A" }]
    }
  ]
}
