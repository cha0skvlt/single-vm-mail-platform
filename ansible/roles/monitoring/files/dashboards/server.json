{
  "uid": "mail-server",
  "title": "Server",
  "tags": ["mail", "node"],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "targets": [{ "expr": "time() - node_boot_time_seconds", "refId": "A", "legendFormat": "uptime" }]
    },
    {
      "id": 2, "type": "stat", "title": "CPU",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}] } }, "overrides": [] },
      "targets": [{ "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "RAM used",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 80}, {"color": "red", "value": 92}] } }, "overrides": [] },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Disk / used",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}] } }, "overrides": [] },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})", "refId": "A" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "CPU usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 15, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A", "legendFormat": "used" },
        { "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[5m]))", "refId": "B", "legendFormat": "iowait" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "refId": "A", "legendFormat": "used" },
        { "expr": "node_memory_MemAvailable_bytes", "refId": "B", "legendFormat": "available" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Disk /",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}", "refId": "A", "legendFormat": "used" },
        { "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "refId": "B", "legendFormat": "free" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Network",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br.*\"}[5m]))", "refId": "A", "legendFormat": "rx" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br.*\"}[5m]))", "refId": "B", "legendFormat": "tx" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Load",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 8, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "node_load1", "refId": "A", "legendFormat": "1m" },
        { "expr": "node_load5", "refId": "B", "legendFormat": "5m" },
        { "expr": "node_load15", "refId": "C", "legendFormat": "15m" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Disk I/O",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 8, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(node_disk_read_bytes_total[5m]))", "refId": "A", "legendFormat": "read" },
        { "expr": "sum(rate(node_disk_written_bytes_total[5m]))", "refId": "B", "legendFormat": "write" }
      ]
    }
  ]
}
