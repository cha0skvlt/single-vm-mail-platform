[Unit]
Description=mail Promtail (mail.log + journal → Loki)
After=network.target loki.service
Wants=loki.service

[Service]
Type=simple
User=promtail
Group=adm
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/promtail -config.file=/etc/promtail/config.yml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
