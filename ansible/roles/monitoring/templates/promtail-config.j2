server:
  http_listen_address: 127.0.0.1
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://127.0.0.1:3100/loki/api/v1/push

scrape_configs:
  - job_name: mail
    static_configs:
      - targets: [localhost]
        labels:
          job: mail
          host: {{ hostname }}
          __path__: /var/log/mail.log
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: systemd
        host: {{ hostname }}
    relabel_configs:
      - source_labels: ["__journal__systemd_unit"]
        target_label: unit
